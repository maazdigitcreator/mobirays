{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mobirays.voucherndeals.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://mobirays.voucherndeals.com/storage/:path*"
    },
    {
      "source": "/((?!api/|storage/).*)",
      "destination": "/index.html"
    }
  ]
}
